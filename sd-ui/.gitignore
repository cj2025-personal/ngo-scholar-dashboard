# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Browser suite output
tests-e2e/.state.json
tests-e2e/results/
tests-e2e/report/

# playwright: run output and generated screenshots, never inputs
/test-results/
/tests-e2e/results/
/tests-e2e/screens/
/tests-e2e/screens-*/
/playwright-report/
/blob-report/
/playwright/.cache/
