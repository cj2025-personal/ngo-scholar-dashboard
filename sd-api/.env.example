# sd-api configuration.
#
# Copy to .env and fill in. Every variable the service reads is listed here,
# grouped by what stops working without it, because the previous version of
# this file documented eighteen of forty-seven — including the two the process
# throws on at boot — and a deployment configured from it could not start.
#
# REQUIRED marks the ones with no default: absent, the process exits.
# Everything else has a working default or disables one feature when unset.

# ── Required ───────────────────────────────────────────────────────────────
# REQUIRED. Connection string. Keep credentials out of source control.
MONGODB_URI=
# REQUIRED. Database name.
MONGODB_DB=

# ── HTTP ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated allowlist. Anything not listed is refused with 403.
CORS_ORIGIN=http://localhost:3000

# ── Sessions ───────────────────────────────────────────────────────────────
AUTH_COOKIE_NAME=sd_session
AUTH_SESSION_TTL_DAYS=14
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_HISTORY_LIMIT=5
AUTH_LINKABLE_COLLECTIONS=
# Unset in development, where the cookie is host-only on localhost and is
# already shared across ports. At deploy, the shared parent domain — e.g.
# ".archivyn.example" — so sibling subdomains see one scholar session.
AUTH_COOKIE_DOMAIN=

# ── Service-to-service ─────────────────────────────────────────────────────
# Shared secret our own services present to issue invitations. ABSENT MEANS
# INVITATION ISSUING IS DISABLED, not open. Treat as a credential.
SERVICE_TOKEN=

# ── Google Cloud Storage ───────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_EDITORIAL_IMAGES_BUCKET=editorial-images
# Credentials, either way (JSON takes precedence):
# 1. Inline the service account JSON (recommended for deployments)
GCP_SERVICE_ACCOUNT_JSON=
# 2. Or point at a key file kept outside version control (e.g. sd-api/config/key.json)
GCP_SERVICE_ACCOUNT_KEY_FILE=
# Read as a fallback by the Google client libraries; same file as above.
GOOGLE_APPLICATION_CREDENTIALS=
# Read as fallbacks for GCP_PROJECT_ID.
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
# Alternative name for GCP_EDITORIAL_IMAGES_BUCKET.
GCS_EDITORIAL_IMAGES_BUCKET=

# ── S3 (legacy asset path) ─────────────────────────────────────────────────
# Credentials. Only needed where the S3 client is still used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# ── Drafting ("Draft from my research") ────────────────────────────────────
# Optional: unset disables the drafter rather than failing the boot. Same names
# user-dashboard-api reads, so one deployment config serves both.
LLM_PROVIDER=vertex
STORY_LLM_MODEL=gemini-2.5-flash
GCP_LOCATION=us-central1
# Fallbacks for the two above.
LLM_MODEL=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
# A pre-minted token, for local runs without a service account.
VERTEX_ACCESS_TOKEN=
# Kill switch, and the ability to serve the API without running the queue
# (a second replica, or a dev instance pointed at shared data).
DRAFTING_ENABLED=true
DRAFTING_WORKER=true
DRAFTING_POLL_MS=2000
# Per-scholar drafts per day.
DRAFT_DAILY_CAP=10
# Staged rollout. "all" (default) or "pilot"; in pilot mode only the listed
# profile ids may draft.
DRAFTING_ROLLOUT=all
DRAFTING_PILOT_PROFILES=
# Illustrations through Vertex Imagen. Off until a deployment turns it on.
DRAFTING_IMAGES=false
IMAGE_MODEL=

# ── Evidence ledger ────────────────────────────────────────────────────────
# Ed25519 private key (PEM, or base64 of one) that signs published evidence
# manifests. A credential. Absent in production, manifests go out marked
# unsigned and the boot log says so; outside production a key is generated per
# process so local runs still verify.
LEDGER_SIGNING_KEY=
LEDGER_KEY_ID=

# ── Watching the scientific record ─────────────────────────────────────────
RECORD_CHECKS=true
# Guards the endpoint a scheduler calls. Absent means the sweep is DISABLED,
# not open. Treat as a credential.
RECORD_SWEEP_TOKEN=
# Crossref asks API callers to identify themselves; they rate-limit those who
# do not. An address you actually read.
CROSSREF_MAILTO=
# Answers the record check from a fixture instead of the live registrars.
RECORD_FAKE=

# ── Tracing (optional) ─────────────────────────────────────────────────────
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=archivyn-drafting
LANGSMITH_DRAFT_DATASET=
# Older names for the two above, still read.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=

# ── Test fixtures ──────────────────────────────────────────────────────────
# Drive refusal paths in the suites against LLM_PROVIDER=fake. Never set these
# in a deployment; they make the fake model produce deliberately bad output.
# FAKE_MODEL_FIRST_PERSON=1
# FAKE_MODEL_UNSUPPORTED_CLAIM=1
# FAKE_MODEL_OVERREACH=1
