PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_COOKIE_NAME=sd_session
AUTH_SESSION_TTL_DAYS=14
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_HISTORY_LIMIT=5
AUTH_LINKABLE_COLLECTIONS=

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_EDITORIAL_IMAGES_BUCKET=editorial-images
# Provide credentials one of two ways (JSON takes precedence):
# 1. Inline the service account JSON (recommended for deployments)
GCP_SERVICE_ACCOUNT_JSON=
# 2. Or point at a key file kept outside version control (e.g. sd-api/config/key.json)
GCP_SERVICE_ACCOUNT_KEY_FILE=

# Drafting ("Draft from my research"). Optional: unset disables the drafter.
# Same names user-dashboard-api reads, so one deployment config serves both.
LLM_PROVIDER=vertex
STORY_LLM_MODEL=gemini-2.5-flash
GCP_LOCATION=us-central1

# Staged rollout of drafting. "all" (default) or "pilot"; in pilot mode only the listed profile ids may draft.
DRAFTING_ROLLOUT=all
DRAFTING_PILOT_PROFILES=
# Per-scholar drafts per day.
DRAFT_DAILY_CAP=10
# Optional: LangSmith tracing and eval experiments.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=archivyn-drafting
