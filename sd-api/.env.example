PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_COOKIE_NAME=sd_session
AUTH_SESSION_TTL_DAYS=14
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_HISTORY_LIMIT=5
AUTH_LINKABLE_COLLECTIONS=

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_EDITORIAL_IMAGES_BUCKET=editorial-images
# Provide credentials one of two ways (JSON takes precedence):
# 1. Inline the service account JSON (recommended for deployments)
GCP_SERVICE_ACCOUNT_JSON=
# 2. Or point at a key file kept outside version control (e.g. sd-api/config/key.json)
GCP_SERVICE_ACCOUNT_KEY_FILE=
